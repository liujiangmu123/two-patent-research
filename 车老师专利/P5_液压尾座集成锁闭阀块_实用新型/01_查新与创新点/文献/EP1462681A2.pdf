      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:identifier>EP-1462681-A2-20040929</dc:identifier>
         <dc:format>application/pdf</dc:format>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">An electro-hydraulic manifold assembly with a plurality of solenoid operated valves (16-26) disposed on a manifold block (12) and each operable to control pressure from the inlet to a separate outlet. Sensing ports are provided in each outlet with a pressure sensor (32-40) sealed over the sensing port for providing a signal indicative of the sensed pressure. The pressure sensors are mounted on a lead frame (14) and connected to conductive strips in the lead frame. The lead frame has slots therein which permit the frame to be simultaneously electrically connected by bayonet connection to the terminals on each solenoid valve as the transducers are sealed over the sensing ports and the lead frame attached to the manifold block. [image]</rdf:li>
               <rdf:li xml:lang="en">An electro-hydraulic manifold assembly with a plurality of solenoid operated valves (16-26) disposed on a manifold block (12) and each operable to control pressure from the inlet to a separate outlet. Sensing ports are provided in each outlet with a pressure sensor (32-40) sealed over the sensing port for providing a signal indicative of the sensed pressure. The pressure sensors are mounted on a lead frame (14) and connected to conductive strips in the lead frame. The lead frame has slots therein which permit the frame to be simultaneously electrically connected by bayonet connection to the terminals on each solenoid valve as the transducers are sealed over the sensing ports and the lead frame attached to the manifold block. [image]</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:language>
            <rdf:Bag>
               <rdf:li>en</rdf:li>
            </rdf:Bag>
         </dc:language>
         <dc:publisher>
            <rdf:Bag>
               <rdf:li>European Patent Office</rdf:li>
            </rdf:Bag>
         </dc:publisher>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>EP1462681</rdf:li>
               <rdf:li>EP 1462681</rdf:li>
               <rdf:li>F16H 61/00</rdf:li>
               <rdf:li>Electro-hydraulic manifold assembly with lead frame mounted pressure sensors</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Electro-hydraulic manifold assembly with lead frame mounted pressure sensors - European Patent Office - EP 1462681 A2</rdf:li>
               <rdf:li xml:lang="en">Electro-hydraulic manifold assembly with lead frame mounted pressure sensors - European Patent Office - EP 1462681 A2</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:type>
            <rdf:Bag>
               <rdf:li>EUROPEAN PATENT APPLICATION</rdf:li>
            </rdf:Bag>
         </dc:type>
      </rdf:Description>
